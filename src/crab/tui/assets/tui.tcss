/* Palette Sapienza Università di Roma - Dark Mode */
$background: #202020;        /* Sfondo grigio scuro */
$surface: #353535;          /* Superficie per elementi in rilievo */
$primary: #c09a58;          /* Oro Sapienza per elementi interattivi */
$secondary: #a72a3b;        /* Rosso Sapienza più brillante per hover/focus */
$accent: #822433;           /* Rosso Sapienza istituzionale */
$text: #f8f8f2;             /* Testo bianco sporco per leggibilità */


Screen {
    background: $background;
    color: $text;
}

Header, Footer {
    background: $accent;
    color: $text;
}

/* ---------------------------- Top navigation bar ----------------------- */
#tab-selector {
    padding: 1;
    height: auto;
    border-bottom: solid $accent;
}

.tab {
    margin: 0 1;
    border: round $accent;
}

.tab.-primary {
    background: $accent;
    color: $text;
}

.tab:hover {
    background: $secondary;
}


.action-buttons {
    align: right top;
    height: auto;
}


.save-btn, .load-btn, .run-btn {
    margin: 0 1;
   
}


#main-content-area {
    height: 1fr;
}

/* ── Experiments panel ────────────────────────────────────────────── */

ExperimentsPanel {
    height: 1fr;
}

/* Experiment strip (top row) */
ExperimentStrip {
    height: auto;
    padding: 0 1;
    border-bottom: solid $surface;
    background: $background;
}

.exp-tab {
    margin: 0 0 0 0;
    border: round $accent;
    min-width: 14;
    max-width: 30;
}

.exp-tab.-primary {
    background: $accent;
    color: $text;
}

.exp-tab:hover {
    background: $secondary;
}

.exp-close-btn {
    min-width: 3;
    max-width: 3;
    margin: 0 1 0 0;
    border: none;
    background: $surface;
    color: $text;
}

.exp-close-btn:hover {
    background: $secondary;
}

.add-exp-btn {
    margin: 0 0 0 2;
    border: dashed $accent;
    background: $background;
    color: $primary;
    min-width: 14;
}

.add-exp-btn:hover {
    background: $surface;
}

/* Experiment identity row (name + description) */
#exp-identity {
    height: auto;
    padding: 1 2 0 2;
    background: $surface;
}

.exp-meta-row {
    height: auto;
    layout: horizontal;
}

.exp-meta-group {
    width: 1fr;
    height: auto;
    margin-right: 2;
    layout: vertical;
}

.exp-meta-group:last-child {
    margin-right: 0;
}

.exp-meta-label {
    color: $primary;
    margin: 0 0 0 0;
}

.exp-meta-input {
    width: 100%;
    margin: 0 0 1 0;
    background: $background;
    border: tall $surface;
}

.exp-meta-input:focus {
    border: tall $primary;
}

/* App strip */
AppStrip {
    height: auto;
    padding: 0 1;
    margin-top: 1;
    border-bottom: solid $surface;
}

.app-tab {
    margin: 0 0 0 0;
    border: round $surface;
    min-width: 8;
    max-width: 14;
}

.app-tab.-primary {
    background: $surface;
    color: $text;
    border: round $primary;
}

.app-tab:hover {
    background: $surface;
    border: round $secondary;
}

.app-close-btn {
    min-width: 3;
    max-width: 3;
    margin: 0 1 0 0;
    border: none;
    background: $background;
    color: $text;
}

.app-close-btn:hover {
    background: $secondary;
}

.add-app-btn {
    margin: 0 0 0 1;
    border: dashed $surface;
    background: $background;
    color: $text;
    min-width: 8;
}

.add-app-btn:hover {
    background: $surface;
}

/* Scrollable content area */
#exp-content-scroll {
    height: 1fr;
    overflow-y: auto;
    padding: 1 2;
}

/* Confirmation modal */
ConfirmModal {
    align: center middle;
}

#confirm-dialog {
    background: $surface;
    border: round $accent;
    padding: 2 4;
    width: 50;
    height: auto;
    align: center middle;
}

#confirm-message {
    text-align: center;
    margin-bottom: 2;
    color: $text;
}

#confirm-buttons {
    height: auto;
    align: center middle;
    layout: horizontal;
}

#confirm-buttons Button {
    margin: 0 1;
    min-width: 10;
}

/* Legacy selector compat — keep old names working if any ref survives */
ApplicationSetup {
    height: 1fr;
}

BenchmarkTabSelector {
    height: auto;
}

LocalOptionsForm {
    height: auto;
}


ApplicationForm {
    height: auto;
}

.form-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 0;
}

.form-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.form-col:last-child {
    margin-right: 0;
}


AutoCompleteInput {
    height: auto;
    max-height: 15;
}

#path {
    color:$text;
    border: round $primary;
    background: $surface;
}

#path-suggestions {
    max-height: 8;
    border: round $primary;
    background: $surface;
    margin: 0;
}

#path-suggestion > Label {
}

#path-suggestions > ListItem {
    padding: 0;
    height: auto;
    color: $primary;
}

#path-suggestions > ListItem:hover {
    background: $secondary;
}

#path-suggestions > ListItem.-highlighted {
    background: $primary;
}

Input, Checkbox, Label {
    margin: 1 0;
}


Input:hover {
    border: thick $secondary;
}

Input:focus {
    border: thick $primary;
}


Checkbox:hover {
    background: $secondary;
}

Checkbox:focus {
    background: $secondary;
}


Label:hover {
    color: $secondary;
}

.placeholder {
    text-align: center;
    padding: 5;
    color: $text;
}

#log-view-container {
    /* This container wraps the log widget in the new tab */
    padding: 0 1;
}

.runner-log-tall {
    /* This makes the log widget fill the available vertical space */
    height: 1fr;
}

.placeholder {
    align: center middle;
}

/* Styles for Environment Settings Tab */
.top_bar {
    height: auto;
    align: left middle;
    padding: 1 2;
    margin-bottom: 1;
}

.top_bar > .label {
    width: auto;
    margin-right: 2;
    height: 3;
    content-align-vertical: middle;
}

.top_bar > Select {
    width: auto;
    max-width: 25;
}

.top_bar > .spacer {
    width: 1fr;
}

#custom_save_area {
    height: auto;
    width: auto;
    align: right middle;
    padding: 0 2;
    margin-bottom: 1;
}

#custom_save_area.hidden {
    display: none;
}

#custom_save_area > Button {
    margin-right: 1;
}
#custom_save_area > Input {
    width: 30;
    margin: 0;
}

#variable_list {
    border: round $primary;
    padding: 0 1;
}

VariableRow {
    height: auto;
    margin: 1 0;
}

VariableRow > Input {
    margin: 0; /* Azzera il margine verticale per allineare gli input */
}

VariableRow > .variable_value {
    margin-left: 1; /* Mantiene un po' di spazio tra i due input */
}

.variable_key {
    width: 30%;
}

.variable_value {
    width: 1fr;
    margin: 0 1;
}

.delete_variable_btn {
    min-width: 5;
    max-width: 5;
    height: 3;
}


/* Benchmark Setup   */

/* Stile per il container principale del form */
BenchmarkOptions {
    layout: vertical;
    overflow-y: auto;  /* Permette lo scorrimento verticale */
    overflow-x: hidden;
    padding: 1 2;
    
    height: 100%;

}

/* Stile per il titolo principale del form */
#benchmark-options-title {
    content-align: center middle;
    width: 100%;
    margin-bottom: 1;
    text-style: bold underline;
}

/* 
 * Container per ogni singola opzione (Label + Input).
 */
.option-group {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;

    /* MODIFICA CHIAVE: Allinea verticalmente gli elementi al centro */
    align-vertical: middle;
}

/* Stile per tutte le etichette delle opzioni */
.option-label {
    width: 35%;
    text-align: right;
    padding: 1;
    margin: 1 0;
}

/* Stile per tutti i campi di input (Input, Select, Switch) */
.option-input {
    width: 1fr;
    margin: 1 0;
}

Switch.option-input {
    width: auto;
    height: 1;
}

.bench-check {
    width: auto;
    height: auto;
    margin: 0 0 1 0;
}

Select.option-input {
    width: 1fr;
}

TextArea.option-input {
    width: 1fr;
    min-height: 5;
    max-height: 10;
}

/* Two-column row for paired fields */
.options-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.options-row > .option-group {
    layout: vertical;
    width: 1fr;
    height: auto;
    margin-right: 2;
    margin-bottom: 0;
}

.options-row > .option-group:last-child {
    margin-right: 0;
}

.options-row > .option-group > .option-label {
    width: 100%;
    text-align: left;
    padding: 0;
    margin: 0 0 0 0;
}

.options-row > .option-group > .option-input {
    width: 100%;
    max-width: 100%;
    margin: 0 0 1 0;
}

/* Collapsible benchmark sections */
.bench-section {
    margin-bottom: 1;
}

.bench-section > CollapsibleTitle {
    background: $accent;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

.bench-section > CollapsibleTitle:hover {
    background: $secondary;
}

.bench-section > .collapsible--content {
    border: round $surface;
    padding: 1;
    background: $surface;
}

BenchmarkOptions Input, BenchmarkOptions TextArea {
    background: $background;
    border: tall $surface;
}

BenchmarkOptions Input:focus {
    border: tall $primary;
}

BenchmarkOptions Select {
    background: $background;
}

/* Label */
.option-container {
    margin-bottom: 1;
}

.option-container Label {
    color: cyan;
    margin-bottom: 0;
}

/* Node selector layout */
.node-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.node-controls {
    width: 30;
    height: auto;
}

.node-controls > .option-label {
    margin: 0 0 0 0;
    padding: 0;
}

.node-controls > .node-select {
    width: 28;
    margin: 0 0 1 0;
}

.node-table-area {
    width: 1fr;
    height: auto;
    max-height: 12;
    padding-left: 2;
    padding-right: 3;
    overflow-y: auto;
}

/* Data Label */
.datatable {
    width: 1fr;
    margin: 0;
    max-height: 12;
    overflow-x: hidden;
}

/* Stile per il container dei pulsanti in fondo */
.button-container {
    align: center middle;
    width: 100%;
    height: auto;
    margin-top: 1;
}

.button-container Button {
    margin: 0 1;
}
