! Quantum ESPRESSO pw.x SCF input: 8-atom cubic diamond silicon. The size is a best guess,
! tuned against a timing on the cluster (ecutwfc and the K_POINTS grid set the run time).
&CONTROL
    calculation = 'scf'
    prefix = 'si'
    outdir = './scratch/'
    pseudo_dir = './pseudo/'
/
&SYSTEM
    ibrav = 1
    celldm(1) = 10.26
    nat = 8
    ntyp = 1
    ecutwfc = 40
/
&ELECTRONS
    conv_thr = 1.0d-8
/
ATOMIC_SPECIES
Si 28.086 Si.pz-vbc.UPF
ATOMIC_POSITIONS crystal
Si 0.00 0.00 0.00
Si 0.00 0.50 0.50
Si 0.50 0.00 0.50
Si 0.50 0.50 0.00
Si 0.25 0.25 0.25
Si 0.25 0.75 0.75
Si 0.75 0.25 0.75
Si 0.75 0.75 0.25
K_POINTS automatic
4 4 4 0 0 0
