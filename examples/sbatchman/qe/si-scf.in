! Quantum ESPRESSO pw.x SCF input: 128-atom silicon supercell (2x2x4 diamond cells of 10.26 bohr), ecutwfc = 60, a 2x2x1 k-point grid.
! On one Leonardo node with 4 GPUs one run takes about 20 seconds; change the supercell, ecutwfc or the k grid to change the run time.
&CONTROL
    calculation = 'scf'
    prefix = 'si'
    outdir = './scratch/'
    pseudo_dir = './pseudo/'
/
&SYSTEM
    ibrav = 0
    nat = 128
    ntyp = 1
    ecutwfc = 60
/
&ELECTRONS
    conv_thr = 1.0d-8
/
ATOMIC_SPECIES
Si 28.086 Si.pz-vbc.UPF
CELL_PARAMETERS bohr
20.5200 0.0000 0.0000
0.0000 20.5200 0.0000
0.0000 0.0000 41.0400
