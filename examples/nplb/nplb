#!/usr/bin/env bash
# The NPLB campaign tool for the lab console: one short command per task.
#   nplb VERB [ARGS]      (after `. examples/nplb/env.sh`, which defines the nplb function;
#                          or run examples/nplb/nplb directly)
# Verbs so far: help, fix-venv, page, reports, build, node, topo, net, campaign, next, queue, follow,
# run, cancel, skip. Exit 0 on success, 1 when a step failed, 2 on an unknown verb or a usage error.
# PYTHONPATH is unset here on purpose: the lab shell exports one that points at an old system
# argparse, which sbatch copies into every job and the workers then crash.
# To add a verb: write a cmd_<verb> function and one case arm below.
set -u

unset PYTHONPATH

NPLB_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
CHECKOUT=$(cd "$NPLB_DIR/../.." && pwd)

step() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }

cmd_help() {
    cat <<'EOF'
nplb VERB [ARGS]

  help        this page
  fix-venv    reinstall CRAB into the checkout venv (pip install -e .) and run pip check
  page N|next|prev [REPORT]   replay a page of a saved report (pages of at most 38 lines)
  reports     list the saved reports, newest first
  build blink [HOST...]   rebuild the GPU Blink from main (old build moved aside), show the proof
  build check [HOST...]   read-only report on ompi-cuda, ucx-cuda, the Blink source and binaries
  node check [HOST...]    one page of node health, host x check, the verdict first
  node diag HOST          deep dive of one node: hardware or software, the verdict first
  node fix [--sr 0|1] [--ar 0|1] [HOST...]
                          asks first, then remounts NFS on the workers, optionally sets SR/AR
  topo [--from TSV] [HOST...]
                          LLDP probe, node-to-leaf map and layout preview (--from: reuse a probe)
  net declare nplb=on|off ar=on|off
                          record the switch state you set by hand (the switches cannot be read)
  net set sr=on|off [arnic=on|off] [HOST...]
                          set the NIC selective repeat (and adaptive routing) bit, read it back
  net show [HOST...]      declared switch state plus SR and NIC AR of every node, verdict first
  net sheet STATE|--restore
                          switch commands to paste: nplb=on ar=off, base|nplb|ar|nplb+ar, --restore
  net record DIR [HOST...]   write DIR/nplb_state.json, the network state of a run

  campaign [--estimate] [--order tier|state] [--budget-hours H] [--out DIR] [--local]
                          write the blocks and schedule.tsv (local/campaign); --estimate: hours only
  next                    the next schedule row: the network state it needs, the commands to run,
                          progress per tier and the hours left from the real run times
  queue                   the Slurm queue of the partition and the last runs of the run log
  follow [TARGET]         follow a submitted job live, say how it ended, page a summary; Ctrl-C only
                          stops following. TARGET: row, job id or data dir; none = newest submitted
  run N|next [--force] [--no-follow]
                          check every gate, submit the block with crab run, then follow it
  cancel                  scancel the newest submitted job of the run log (asks y/N first)
  skip N.. | --state LABEL | --tier T [--why TEXT] [--undo]
                          drop rows from the plan so next stops proposing them (--undo: restore)

Source examples/nplb/env.sh first: it defines the nplb command and unsets PYTHONPATH.
EOF
}

# run_step LABEL CMD...: narrate, run, show the tail of the output when it fails
run_step() {
    local label=$1 out rc
    shift
    step "$label"
    out=$("$@" 2>&1)
    rc=$?
    if ((rc != 0)); then
        printf '%s\n' "$out" | tail -n 15
        return "$rc"
    fi
    return 0
}

# page and reports go through the pager engine; lib/pages.sh picks the python.
cmd_page() {
    . "$NPLB_DIR/lib/pages.sh"
    nplb_page "$@"
}

cmd_reports() {
    . "$NPLB_DIR/lib/pages.sh"
    _nplb_pages_run reports
}

# build blink|check [HOST...]: blink_build.sh narrates on stderr and prints a paged report
cmd_build() {
    local sub=${1:-}
    [[ $# -gt 0 ]] && shift
    case $sub in
        blink) bash "$NPLB_DIR/blink_build.sh" build "$@" ;;
        check) bash "$NPLB_DIR/blink_build.sh" check "$@" ;;
        *)
            echo "usage: nplb build blink|check [HOST...]" >&2
            return 2
            ;;
    esac
}

# node check|diag|fix: node_tools.sh narrates on stderr and prints a paged report
cmd_node() {
    local sub=${1:-}
    [[ $# -gt 0 ]] && shift
    case $sub in
        check) bash "$NPLB_DIR/node_tools.sh" check "$@" ;;
        diag)
            if (($# == 1)); then
                bash "$NPLB_DIR/node_tools.sh" diag "$@"
            else
                node_usage
            fi
            ;;
        fix) bash "$NPLB_DIR/node_tools.sh" fix "$@" ;;
        *) node_usage ;;
    esac
}

# topo [--from TSV] [HOST...]: topo_tools.sh narrates on stderr and prints a paged report
cmd_topo() {
    bash "$NPLB_DIR/topo_tools.sh" topo "$@"
}

# net declare|set|show|sheet|record: net_tools.sh narrates on stderr and prints a paged report
cmd_net() {
    local sub=${1:-}
    [[ $# -gt 0 ]] && shift
    case $sub in
        declare | set | show | sheet | record) bash "$NPLB_DIR/net_tools.sh" "$sub" "$@" ;;
        *)
            {
                echo "usage: nplb net declare nplb=on|off ar=on|off"
                echo "       nplb net set sr=on|off [arnic=on|off] [HOST...]"
                echo "       nplb net show [HOST...]"
                echo "       nplb net sheet STATE | --restore"
                echo "       nplb net record DIR [HOST...]"
            } >&2
            return 2
            ;;
    esac
}

# campaign [ARGS]: campaign_plan.py narrates on stderr, its report is paged and saved as campaign
cmd_campaign() {
    local py="$CHECKOUT/.venv/bin/python" out rc
    [[ -x $py ]] || py=python3
    . "$NPLB_DIR/lib/pages.sh"
    out=$("$py" "$NPLB_DIR/campaign_plan.py" "$@")
    rc=$?
    if [[ -n $out ]]; then
        printf '%s\n' "$out" | nplb_paged campaign || ((rc != 0)) || rc=1
    fi
    return "$rc"
}

# next: which schedule row to run now (run_log.py), paged and saved as next
cmd_next() {
    local py="$CHECKOUT/.venv/bin/python" out rc
    [[ -x $py ]] || py=python3
    . "$NPLB_DIR/lib/pages.sh"
    out=$("$py" "$NPLB_DIR/run_log.py" next "$@")
    rc=$?
    if [[ -n $out ]]; then
        printf '%s\n' "$out" | nplb_paged next || ((rc != 0)) || rc=1
    fi
    return "$rc"
}

# queue: squeue runs here, in bash, and run_log.py gets its captured output (no squeue: no file)
cmd_queue() {
    local py="$CHECKOUT/.venv/bin/python" part=${PARTITION:-h100_4nodes} sq=${SQUEUE:-squeue}
    local tmp out rc sq_rc
    [[ -x $py ]] || py=python3
    . "$NPLB_DIR/lib/pages.sh"
    tmp=$(mktemp) || return 1
    if command -v "$sq" >/dev/null 2>&1; then
        timeout 30 "$sq" -h -p "$part" -o "%i %j %T %M %l %R" >"$tmp" 2>&1 </dev/null
        sq_rc=$?
        out=$(PARTITION=$part "$py" "$NPLB_DIR/run_log.py" queue --squeue-file "$tmp" --squeue-exit "$sq_rc" "$@")
    else
        out=$(PARTITION=$part "$py" "$NPLB_DIR/run_log.py" queue "$@")
    fi
    rc=$?
    rm -f "$tmp"
    if [[ -n $out ]]; then
        printf '%s\n' "$out" | nplb_paged queue || ((rc != 0)) || rc=1
    fi
    return "$rc"
}

# follow [TARGET]: follow.py narrates on stderr; its stdout is `#report NAME` and the report, which is
# paged and saved as NAME. The exit code is follow.py's (0 OK/WARN, 1 FAIL, 2 bad target, 130 Ctrl-C).
cmd_follow() {
    local py="$CHECKOUT/.venv/bin/python" out rc name
    [[ -x $py ]] || py=python3
    . "$NPLB_DIR/lib/pages.sh"
    out=$("$py" "$NPLB_DIR/follow.py" follow "$@")
    rc=$?
    if [[ $out == '#report '* ]]; then
        name=${out%%$'\n'*}
        name=${name#'#report '}
        out=${out#*$'\n'}
        printf '%s\n' "$out" | nplb_paged "$name" || ((rc != 0)) || rc=1
    fi
    return "$rc"
}

# run N|next [--force] [--no-follow]: run_cmd.py narrates on stderr and prints on stdout either a report
# (exit 1: a refusal or a failed submit, paged and saved as run-gate; exit 0: `VERDICT: DONE ...`, saved
# as run-next) or `submitted: ...` and a last line `job J`. After a submit the job is followed.
cmd_run() {
    local py="$CHECKOUT/.venv/bin/python" out rc last job follow=1 arg
    local args=()
    [[ -x $py ]] || py=python3
    for arg in "$@"; do
        if [[ $arg == --no-follow ]]; then follow=0; else args+=("$arg"); fi
    done
    . "$NPLB_DIR/lib/pages.sh"
    out=$("$py" "$NPLB_DIR/run_cmd.py" run ${args[@]+"${args[@]}"})
    rc=$?
    last=${out##*$'\n'}
    if ((rc == 0)) && [[ $last =~ ^job\ [0-9]+([_+][0-9]+)*$ ]]; then
        if ((follow == 0)); then
            printf '%s\n' "$out"
            return 0
        fi
        job=${last#job }
        printf '%s\n' "${out%$'\n'*}" >&2
        cmd_follow "$job"
        return $?
    fi
    if [[ -n $out ]]; then
        if ((rc == 0)); then
            printf '%s\n' "$out" | nplb_paged run-next || rc=1
        else
            printf '%s\n' "$out" | nplb_paged run-gate || true
        fi
    fi
    return "$rc"
}

# cancel / skip: short answers on stdout, no pager; cancel asks on the terminal, so no capture
cmd_cancel() {
    local py="$CHECKOUT/.venv/bin/python"
    [[ -x $py ]] || py=python3
    "$py" "$NPLB_DIR/run_cmd.py" cancel "$@"
}

cmd_skip() {
    local py="$CHECKOUT/.venv/bin/python"
    [[ -x $py ]] || py=python3
    "$py" "$NPLB_DIR/run_cmd.py" skip "$@"
}

node_usage() {
    echo "usage: nplb node check [HOST...] | diag HOST | fix [--sr 0|1] [--ar 0|1] [HOST...]" >&2
    return 2
}

cmd_fix_venv() {
    local py="$CHECKOUT/.venv/bin/python"
    if [[ ! -x $py ]]; then
        echo "no venv at $CHECKOUT/.venv: run make in $CHECKOUT"
        return 1
    fi
    cd "$CHECKOUT" || return 1
    if ! run_step "pip install -e ." "$py" -m pip install -e .; then
        echo "FAIL venv: pip install -e . failed"
        return 1
    fi
    if ! run_step "pip check" "$py" -m pip check; then
        echo "FAIL venv: pip check reports broken requirements"
        return 1
    fi
    echo "OK venv: pip check clean"
}

verb=${1:-help}
[[ $# -gt 0 ]] && shift
case $verb in
    help | -h | --help) cmd_help ;;
    fix-venv) cmd_fix_venv ;;
    page) cmd_page "$@" ;;
    reports) cmd_reports ;;
    build) cmd_build "$@" ;;
    node) cmd_node "$@" ;;
    topo) cmd_topo "$@" ;;
    net) cmd_net "$@" ;;
    campaign) cmd_campaign "$@" ;;
    next) cmd_next "$@" ;;
    queue) cmd_queue "$@" ;;
    follow) cmd_follow "$@" ;;
    run) cmd_run "$@" ;;
    cancel) cmd_cancel "$@" ;;
    skip) cmd_skip "$@" ;;
    *)
        echo "nplb: unknown verb '$verb', run: nplb help" >&2
        exit 2
        ;;
esac
