# diag run [TARGET]: diag_run.py is read only; its stdout is `#report NAME` and the report, which is paged
# and saved as NAME. Exit 0 for OK, 1 for FAIL and UNKNOWN, 2 for a bad target or usage (stderr).
# diag counters snapshot|diff [HOST...]: diag_counters.sh narrates on stderr and prints a paged report.
cmd_diag() {
    local sub=${1:-} py="$CHECKOUT/.venv/bin/python" out rc name
    [[ $# -gt 0 ]] && shift
    case $sub in
        run) ;;
        counters)
            bash "$NPLB_DIR/diag_counters.sh" "$@"
            return $?
            ;;
        *)
            echo "usage: nplb diag run [TARGET] | nplb diag counters snapshot|diff [HOST...]" >&2
            return 2
            ;;
    esac
    [[ -x $py ]] || py=python3
    . "$NPLB_DIR/lib/pages.sh"
    out=$("$py" "$NPLB_DIR/diag_run.py" "$@")
    rc=$?
    if [[ $out == '#report '* ]]; then
        name=${out%%$'\n'*}
        name=${name#'#report '}
        out=${out#*$'\n'}
        printf '%s\n' "$out" | nplb_paged "$name" || ((rc != 0)) || rc=1
    elif [[ -n $out ]]; then
        printf '%s\n' "$out"
    fi
    return "$rc"
}

