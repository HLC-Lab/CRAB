# cancel / skip: short answers on stdout, no pager; cancel asks on the terminal, so no capture
cmd_cancel() {
    local py="$CHECKOUT/.venv/bin/python"
    [[ -x $py ]] || py=python3
    "$py" "$NPLB_DIR/run_cmd.py" cancel "$@"
}

cmd_skip() {
    local py="$CHECKOUT/.venv/bin/python"
    [[ -x $py ]] || py=python3
    "$py" "$NPLB_DIR/run_cmd.py" skip "$@"
}

# smoke [FEATURE...] | smoke plan [FEATURE...] [--estimate] | smoke follow | smoke cancel: the smoke test has its
# own work folder <WORK>/smoke, so follow and cancel run under its env. smoke_run.py narrates on stderr (and
# the live run pages go there too); its stdout is `#report smoke` and the verdict page, paged and saved as smoke.
cmd_smoke() {
    local sub=${1:-} py="$CHECKOUT/.venv/bin/python" out rc name base
    base=${WORK:-${NPLB_WORK:-$CHECKOUT/local/nplb-work}}/smoke
    [[ -x $py ]] || py=python3
    case $sub in
        follow | cancel)
            shift
            WORK=$base CAMPAIGN_DIR=$base/campaign NPLB_REPORT_DIR=$base/reports "cmd_$sub" "$@"
            return $?
            ;;
        plan)
            shift
            . "$NPLB_DIR/lib/pages.sh"
            out=$("$py" "$NPLB_DIR/smoke.py" plan "$@")
            rc=$?
            if [[ -n $out ]]; then
                printf '%s\n' "$out" | nplb_paged smoke-plan || ((rc != 0)) || rc=1
            fi
            return "$rc"
            ;;
    esac
    . "$NPLB_DIR/lib/pages.sh"
    out=$("$py" "$NPLB_DIR/smoke_run.py" run "$@")
    rc=$?
    if [[ $out == '#report '* ]]; then
        name=${out%%$'\n'*}
        name=${name#'#report '}
        out=${out#*$'\n'}
        printf '%s\n' "$out" | nplb_paged "$name" || ((rc != 0)) || rc=1
    elif [[ -n $out ]]; then
        printf '%s\n' "$out"
    fi
    return "$rc"
}

node_usage() {
    echo "usage: nplb node check [HOST...] | diag HOST | fix [--sr 0|1] [--ar 0|1] [HOST...]" >&2
    echo "       nplb node procs [HOST...] | stop [HOST...]   leftover benchmark processes: list, stop" >&2
    echo "       nplb node scan [HOST...]   every Slurm node of every partition: ssh, GPUs, RDMA, NFS" >&2
    echo "  repairs for fix (each shows a plan and asks first): --links --peermem --nfs-head --rescan" >&2
    return 2
}

cmd_fix_venv() {
    local py="$CHECKOUT/.venv/bin/python"
    if [[ ! -x $py ]]; then
        echo "no venv at $CHECKOUT/.venv: run make in $CHECKOUT"
        return 1
    fi
    cd "$CHECKOUT" || return 1
    if ! run_step "pip install -e ." "$py" -m pip install -e .; then
        echo "FAIL venv: pip install -e . failed"
        return 1
    fi
    if ! run_step "pip check" "$py" -m pip check; then
        echo "FAIL venv: pip check reports broken requirements"
        return 1
    fi
    echo "OK venv: pip check clean"
}

verb=${1:-help}
[[ $# -gt 0 ]] && shift
case $verb in
    help | -h | --help) cmd_help ;;
    fix-venv) cmd_fix_venv ;;
    page) cmd_page "$@" ;;
    reports) cmd_reports ;;
    build) cmd_build "$@" ;;
    node) cmd_node "$@" ;;
    topo) cmd_topo "$@" ;;
    net) cmd_net "$@" ;;
    campaign) cmd_campaign "$@" ;;
    next) cmd_next "$@" ;;
    queue) cmd_queue "$@" ;;
    follow) cmd_follow "$@" ;;
    run) cmd_run "$@" ;;
    cancel) cmd_cancel "$@" ;;
    skip) cmd_skip "$@" ;;
    smoke) cmd_smoke "$@" ;;
    report) cmd_report "$@" ;;
    compare) cmd_compare "$@" ;;
    diag) cmd_diag "$@" ;;
    pack) cmd_pack "$@" ;;
    *)
        echo "nplb: unknown verb '$verb', run: nplb help" >&2
        exit 2
        ;;
esac
