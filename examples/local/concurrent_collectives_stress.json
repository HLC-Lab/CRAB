{
    "schema_version": 2,
    "global_options": {
        "name": "concurrent_collectives_stress",
        "numnodes": "1",
        "ppn": "2",
        "minruns": "5",
        "maxruns": "10",
        "timeout": "1800.0",
        "outformat": "csv",
        "extrainfo": "concurrent_collectives_stress_local",
        "allocation": {
            "mode": "shared"
        }
    },
    "experiments": {
        "01_concurrent_collectives_stress": {
            "description": "An all-to-all and a ring measured while a barrier loop runs on the same machine.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "start": "0",
                    "end": "",
                    "cpus": "0-1"
                },
                "1": {
                    "path": "blink/ring/ring_nb.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "start": "0",
                    "end": "",
                    "cpus": "2-3"
                },
                "2": {
                    "path": "blink/barrier/barrier_b.py",
                    "args": "-endl",
                    "collect": false,
                    "start": "0",
                    "end": "f",
                    "cpus": "4-5"
                }
            }
        }
    }
}
