{
    "global_options": {
        "name": "concurrent_collectives_stress",
        "numnodes": "1",
        "ppn": "1",
        "allocationmode": "l",
        "allocationsplit": "e",
        "minruns": "5",
        "maxruns": "10",
        "timeout": "1800.0",
        "outformat": "csv",
        "extrainfo": "concurrent_collectives_stress_local"
    },
    "experiments": {
        "01_concurrent_collectives_stress": {
            "description": "Concurrent A2A, Barrier, and Ring stress test on local nodes.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 67108864 -iter 1000 -grty 1",
                    "collect": true,
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 67108864 -iter 500 -grty 1",
                    "collect": true,
                    "start": "0",
                    "end": "f"
                },
                "2": {
                    "path": "barrier.py",
                    "args": "-iter 5000",
                    "collect": false,
                    "start": "0",
                    "end": "f"
                },
                "3": {
                    "path": "ring_nb.py",
                    "args": "-msgsize 33554432 -iter 1000",
                    "collect": true,
                    "start": "0",
                    "end": "f"
                }
            }
        }
    }
}
