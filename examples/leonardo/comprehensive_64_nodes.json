{
    "global_options": {
        "name": "comprehensive_64_nodes",
        "numnodes": "64",
        "ppn": "1",
        "minruns": "1",
        "maxruns": "1",
        "timeout": "1800.0",
        "convergeall": true,
        "outformat": "csv",
        "extrainfo": "64nodes_limit_test",
        "sbatch_directives": {
            "time": "00:30:00",
            "job-name": "crab_64n_test"
        },
        "system_sbatch": [
            "--account=IscrB_SWING",
            "--partition=boost_usr_prod"
        ],
        "system_header": [
            "module purge"
        ],
        "allocation": {
            "mode": "linear",
            "partitions": {
                "victim": {},
                "aggressor": {}
            }
        }
    },
    "experiments": {
        "01_scale_a2a_1KB": {
            "description": "A2A scalability 1/5: 1KB message size. Network warmup.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1024 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "02_scale_a2a_64KB": {
            "description": "A2A scalability 2/5: 64KB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 65536 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "03_scale_a2a_256KB": {
            "description": "A2A scalability 3/5: 256KB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 262144 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "04_scale_a2a_1MB": {
            "description": "A2A scalability 4/5: 1MB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "05_scale_a2a_4MB": {
            "description": "A2A scalability 5/5: 4MB message size. Memory safe limit.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 4194304 -iter 20",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "06_bench_ardc_small": {
            "description": "Collective benchmark: AllReduce Doubling 4KB.",
            "apps": {
                "0": {
                    "path": "ardc_b.py",
                    "args": "-msgsize 4096 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "07_bench_bdc_small": {
            "description": "Collective benchmark: Binomial Doubling 4KB.",
            "apps": {
                "0": {
                    "path": "bdc_b.py",
                    "args": "-msgsize 4096 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "08_bench_incast_small": {
            "description": "Collective benchmark: Incast 4KB.",
            "apps": {
                "0": {
                    "path": "inc_b.py",
                    "args": "-msgsize 4096 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "09_bench_ring_small": {
            "description": "Topology benchmark: Non-blocking Ring 4KB.",
            "apps": {
                "0": {
                    "path": "ring_nb.py",
                    "args": "-msgsize 4096 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "10_dep_chain_reaction": {
            "description": "Sequential dependency: Ring starts only after A2A finishes.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 65536 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "ring_nb.py",
                    "args": "-msgsize 65536 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "s0",
                    "end": ""
                }
            }
        },
        "11_dep_delayed_parallel": {
            "description": "Time-offset parallel: Incast at T=0, A2A at T=5s.",
            "apps": {
                "0": {
                    "path": "inc_b.py",
                    "args": "-msgsize 4096 -iter 1000",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1024 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "5",
                    "end": ""
                }
            }
        },
        "12_dep_killer_aggressor": {
            "description": "Aggressor kill: Incast aggressor is killed when A2A victim finishes.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 262144 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 65536 -iter 1000000",
                    "collect": false,
                    "partition": "victim",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "13_int_split_a2a_vs_incast": {
            "description": "Interference 32 vs 32: A2A victim vs Incast aggressor.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 262144 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 262144 -iter 1000",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "14_int_split_ring_vs_bdc": {
            "description": "Interference 32 vs 32: Ring victim vs Binomial Doubling aggressor.",
            "apps": {
                "0": {
                    "path": "ring_nb.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "bdc_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "15_int_split_ardc_vs_noise": {
            "description": "Interference: AllReduce Doubling victim vs fast Incast noise aggressor.",
            "apps": {
                "0": {
                    "path": "ardc_b.py",
                    "args": "-msgsize 262144 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 4096 -iter 10000",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "16_int_concurrent_a2a": {
            "description": "Concurrent: two independent A2A runs on separate halves of the cluster.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "aggressor",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "17_dep_complex_triangular": {
            "description": "Complex timing: Barrier at T=0, Incast at T=2s, A2A starts when Incast finishes.",
            "apps": {
                "0": {
                    "path": "barrier.py",
                    "args": "-iter 500",
                    "collect": false,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 4096 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "2",
                    "end": ""
                },
                "2": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 4096 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "s1",
                    "end": ""
                }
            }
        },
        "18_stability_long_iter": {
            "description": "Stability check: A2A 1KB with 500 iterations for temporal stability.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1024 -iter 500",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "19_sbatch_override_name": {
            "description": "sbatch override: custom job name for this specific experiment.",
            "sbatch_directives": {
                "job-name": "crab_test_19"
            },
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 20",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "20_sbatch_override_time": {
            "description": "sbatch override: extended time and custom job name. A2A 2MB.",
            "sbatch_directives": {
                "time": "00:40:00",
                "job-name": "crab_final_push"
            },
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 2097152 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        }
    }
}