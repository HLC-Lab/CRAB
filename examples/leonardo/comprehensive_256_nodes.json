{
    "global_options": {
        "name": "comprehensive_256_nodes",
        "numnodes": "256",
        "ppn": "1",
        "minruns": "3",
        "maxruns": "5",
        "timeout": "10800.0",
        "convergeall": true,
        "outformat": "csv",
        "extrainfo": "256nodes_comprehensive_test",
        "sbatch_directives": {
            "time": "02:00:00",
            "job-name": "crab_256n_scale"
        },
        "system_sbatch": [
            "--exclusive",
            "--account=IscrB_SWING",
            "--partition=boost_usr_prod"
        ],
        "system_header": [
            "module purge"
        ],
        "allocation": {
            "mode": "linear",
            "partitions": {
                "victim": {},
                "aggressor": {}
            }
        }
    },
    "experiments": {
        "01_scale_a2a_1KB": {
            "description": "A2A scalability 1/8: 256 nodes, 1KB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1024 -iter 1000",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "02_scale_a2a_4KB": {
            "description": "A2A scalability 2/8: 4KB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 4096 -iter 1000",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "03_scale_a2a_64KB": {
            "description": "A2A scalability 3/8: 64KB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 65536 -iter 500",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "04_scale_a2a_1MB": {
            "description": "A2A scalability 4/8: 1MB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "05_scale_a2a_4MB": {
            "description": "A2A scalability 5/8: 4MB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 4194304 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "06_scale_a2a_16MB": {
            "description": "A2A scalability 6/8: 16MB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 16777216 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "07_scale_a2a_64MB": {
            "description": "A2A scalability 7/8: 64MB message size.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 67108864 -iter 20",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "08_scale_a2a_1GB": {
            "description": "A2A scalability 8/8: 1GB message size. Stress bandwidth limit.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1073741824 -iter 10",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "09_dep_sequential_chain": {
            "description": "Sequential dependency: Ring starts only after A2A finishes (chain).",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "ring_nb.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "s0",
                    "end": ""
                }
            }
        },
        "10_dep_parallel_delayed": {
            "description": "Time-offset parallel: A2A at T=0, Incast at T=5s.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "5",
                    "end": ""
                }
            }
        },
        "11_dep_killer_aggressor": {
            "description": "Aggressor kill: Incast aggressor is killed when A2A victim finishes.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 65536 -iter 1000000",
                    "collect": false,
                    "partition": "victim",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "12_dep_killer_chain": {
            "description": "Chain killer: Barrier first, then A2A victim starts; Incast aggressor lives while A2A is active.",
            "apps": {
                "0": {
                    "path": "barrier.py",
                    "args": "-iter 1000",
                    "collect": false,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "s0",
                    "end": ""
                },
                "2": {
                    "path": "inc_b.py",
                    "args": "-msgsize 65536 -iter 1000000",
                    "collect": false,
                    "partition": "victim",
                    "start": "s0",
                    "end": "f"
                }
            }
        },
        "13_int_split_a2a_vs_incast": {
            "description": "Interference 128 vs 128: A2A victim vs Incast aggressor.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 4194304 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 4194304 -iter 1000",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "14_int_split_ring_vs_a2a": {
            "description": "Interference 128 vs 128: Ring victim vs A2A aggressor.",
            "apps": {
                "0": {
                    "path": "ring_nb.py",
                    "args": "-msgsize 4194304 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 4194304 -iter 1000",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "15_int_split_ardc_vs_bdc": {
            "description": "Collective comparison: AllReduce Doubling (P0) vs Binomial Doubling (P1) running concurrently.",
            "apps": {
                "0": {
                    "path": "ardc_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "bdc_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "aggressor",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "16_int_quiet_neighbor": {
            "description": "Quiet neighbor baseline: A2A on 128 nodes, remaining 128 idle.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "17_bench_ardc_full": {
            "description": "Functionality: AllReduce Doubling benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "ardc_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "18_bench_bdc_full": {
            "description": "Functionality: Binomial Doubling benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "bdc_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "19_bench_incast_full": {
            "description": "Functionality: Incast benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "inc_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "20_bench_ring_nb_full": {
            "description": "Functionality: Non-blocking Ring benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "ring_nb.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "21_override_long_run": {
            "description": "Override test: extended time limit and custom job name. A2A long run.",
            "sbatch_directives": {
                "time": "03:00:00",
                "job-name": "crab_override_test"
            },
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 1048576 -iter 5000",
                    "collect": true,
                    "partition": "victim",
