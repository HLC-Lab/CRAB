{
    "global_options": {
        "name": "allreduce_vs_a2a",
        "numnodes": "8",
        "ppn": "1",
        "minruns": "1",
        "maxruns": "1",
        "timeout": "600.0",
        "outformat": "csv",
        "extrainfo": "8_node_allreduce_vs_a2a",
        "sbatch_directives": {
            "time": "00:20:00",
            "job-name": "crab_ardc_vs_a2a"
        },
        "system_sbatch": [
            "--account=IscrB_SWING",
            "--partition=boost_usr_prod"
        ],
        "system_header": [
            "module purge"
        ],
        "allocation": {
            "mode": "interleaved",
            "split": [
                50,
                50
            ]
        }
    },
    "experiments": {
        "01_allreduce_vs_a2a": {
            "description": "AllReduce Doubling victim vs A2A aggressor on 8 interleaved nodes. A2A aggressor starts after 3s.",
            "apps": {
                "0": {
                    "path": "ardc_b.py",
                    "args": "-msgsize 268435456 -iter 500 -maxsamples 500",
                    "collect": true,
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 33554432 -iter 999999",
                    "collect": false,
                    "start": "3.0",
                    "end": "f"
                }
            }
        }
    }
}