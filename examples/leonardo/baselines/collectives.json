{
    "global_options": {
        "name": "collectives_baseline",
        "numnodes": "8",
        "ppn": "1",
        "allocation": { "mode": "linear" },
        "minruns": "10",
        "maxruns": "30",
        "alpha": "0.05",
        "beta": "0.05",
        "timeout": "300.0",
        "outformat": "csv",
        "sbatch_directives": { "time": "02:00:00", "job-name": "crab_baselines" }
    },
    "experiments": {
        "a2a_8B":       { "apps": { "0": { "path": "blink/a2a_comm_only.py",  "args": "-msgsize 8 -iter 5000",       "collect": true, "start": "0", "end": "" } } },
        "a2a_64B":      { "apps": { "0": { "path": "blink/a2a_comm_only.py",  "args": "-msgsize 64 -iter 5000",      "collect": true, "start": "0", "end": "" } } },
        "a2a_4KB":      { "apps": { "0": { "path": "blink/a2a_comm_only.py",  "args": "-msgsize 4096 -iter 1000",    "collect": true, "start": "0", "end": "" } } },
        "a2a_64KB":     { "apps": { "0": { "path": "blink/a2a_comm_only.py",  "args": "-msgsize 65536 -iter 200",    "collect": true, "start": "0", "end": "" } } },
        "a2a_1MB":      { "apps": { "0": { "path": "blink/a2a_comm_only.py",  "args": "-msgsize 1048576 -iter 50",   "collect": true, "start": "0", "end": "" } } },
        "incast_8B":    { "apps": { "0": { "path": "blink/inc_b.py",          "args": "-msgsize 8 -iter 5000",       "collect": true, "start": "0", "end": "" } } },
        "incast_64B":   { "apps": { "0": { "path": "blink/inc_b.py",          "args": "-msgsize 64 -iter 2000",      "collect": true, "start": "0", "end": "" } } },
        "incast_1MB":   { "apps": { "0": { "path": "blink/inc_b.py",          "args": "-msgsize 1048576 -iter 50",   "collect": true, "start": "0", "end": "" } } },
        "agtr_64B":     { "apps": { "0": { "path": "blink/agtr_comm_only.py", "args": "-msgsize 64 -iter 2000",      "collect": true, "start": "0", "end": "" } } },
        "agtr_1MB":     { "apps": { "0": { "path": "blink/agtr_comm_only.py", "args": "-msgsize 1048576 -iter 50",   "collect": true, "start": "0", "end": "" } } }
    }
}
