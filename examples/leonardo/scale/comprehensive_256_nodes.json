{
    "schema_version": 2,
    "global_options": {
        "name": "comprehensive_256_nodes",
        "numnodes": "256",
        "ppn": "1",
        "minruns": "3",
        "maxruns": "5",
        "timeout": "6600.0",
        "convergeall": true,
        "outformat": "csv",
        "extrainfo": "256nodes_comprehensive_test",
        "sbatch_directives": {
            "time": "02:00:00",
            "job-name": "crab_256n_scale",
            "exclusive": true
        },
        "allocation": {
            "mode": "linear",
            "partitions": {
                "victim": {},
                "aggressor": {}
            }
        }
    },
    "experiments": {
        "01_scale_a2a_1KB": {
            "description": "A2A scalability 1/8: 256 nodes, 1KB message size.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1024 -iter 1000",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            },
            "local_options": {
                "allocation": {
                    "mode": "linear"
                }
            }
        },
        "02_scale_a2a_4KB": {
            "description": "A2A scalability 2/8: 4KB message size.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 4096 -iter 1000",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "03_scale_a2a_64KB": {
            "description": "A2A scalability 3/8: 64KB message size.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 65536 -iter 500",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "04_scale_a2a_1MB": {
            "description": "A2A scalability 4/8: 1MB message size.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "05_scale_a2a_4MB": {
            "description": "A2A scalability 5/8: 4MB message size.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 4194304 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "06_scale_a2a_16MB": {
            "description": "A2A scalability 6/8: 16MB message size.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 16777216 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "07_scale_a2a_64MB": {
            "description": "A2A scalability 7/8: 64MB message size.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 67108864 -iter 20",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "08_scale_a2a_256MB": {
            "description": "A2A scalability 8/8: 256MB message size. Stress bandwidth limit.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 268435456 -iter 10",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "09_dep_sequential_chain": {
            "description": "Sequential dependency: Ring starts only after A2A finishes (chain).",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "blink/ring/ring_nb.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "s0",
                    "end": ""
                }
            }
        },
        "10_dep_parallel_delayed": {
            "description": "Time-offset parallel: A2A at T=0, Incast at T=1s while the A2A is still running.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 4000",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "blink/incast/incast_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "1",
                    "end": ""
                }
            }
        },
        "11_dep_killer_aggressor": {
            "description": "Aggressor kill: Incast aggressor is killed when A2A victim finishes.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/incast/incast_b.py",
                    "args": "-endl -msgsize 65536",
                    "collect": false,
                    "partition": "victim",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "12_dep_killer_chain": {
            "description": "Chain killer: Incast aggressor runs from T=0; Barrier first (T=3s), then A2A victim starts while the aggressor is active.",
            "apps": {
                "0": {
                    "path": "blink/barrier/barrier_b.py",
                    "args": "-iter 1000",
                    "collect": false,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 50",
                    "collect": true,
                    "partition": "victim",
                    "start": "s0",
                    "end": ""
                },
                "2": {
                    "path": "blink/incast/incast_b.py",
                    "args": "-endl -msgsize 65536",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "13_int_split_a2a_vs_incast": {
            "description": "Interference 128 vs 128: A2A victim vs Incast aggressor.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 4194304 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/incast/incast_b.py",
                    "args": "-endl -msgsize 4194304",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "14_int_split_ring_vs_a2a": {
            "description": "Interference 128 vs 128: Ring victim vs A2A aggressor.",
            "apps": {
                "0": {
                    "path": "blink/ring/ring_nb.py",
                    "args": "-msgsize 4194304 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-endl -msgsize 4194304",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "15_int_split_ardc_vs_bdc": {
            "description": "Collective comparison: AllReduce (P0) vs Broadcast (P1) running concurrently.",
            "apps": {
                "0": {
                    "path": "blink/allreduce/allreduce_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "blink/broadcast/broadcast_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "aggressor",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "16_int_quiet_neighbor": {
            "description": "Quiet neighbor baseline: A2A on 128 nodes, remaining 128 idle.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        },
        "17_bench_ardc_full": {
            "description": "Functionality: AllReduce benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "blink/allreduce/allreduce_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            },
            "local_options": {
                "allocation": {
                    "mode": "linear"
                }
            }
        },
        "18_bench_bdc_full": {
            "description": "Functionality: Broadcast benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "blink/broadcast/broadcast_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            },
            "local_options": {
                "allocation": {
                    "mode": "linear"
                }
            }
        },
        "19_bench_incast_full": {
            "description": "Functionality: Incast benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "blink/incast/incast_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            },
            "local_options": {
                "allocation": {
                    "mode": "linear"
                }
            }
        },
        "20_bench_ring_nb_full": {
            "description": "Functionality: Non-blocking Ring benchmark on 256 nodes.",
            "apps": {
                "0": {
                    "path": "blink/ring/ring_nb.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            },
            "local_options": {
                "allocation": {
                    "mode": "linear"
                }
            }
        },
        "21_long_run": {
            "description": "Long run: A2A with 5000 iterations, within the job's time limit.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 1048576 -iter 5000",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                }
            }
        }
    }
}