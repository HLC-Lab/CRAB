{
    "global_options": {
        "name": "a2a_vs_a2a_16MiB",
        "numnodes": "16",
        "ppn": "4",
        "minruns": "1",
        "maxruns": "1",
        "timeout": "1200.0",
        "outformat": "csv",
        "extrainfo": "AI-training-analysis",
        "sbatch_directives": {
            "time": "00:20:00",
            "job-name": "AI-training-analysis",
            "exclusive": true
        },
        "allocation": {
            "mode": "interleaved",
            "partitions": {
                "victim": {
                    "share": 35
                },
                "aggressor": {
                    "share": 65
                }
            }
        }
    },
    "experiments": {
        "exp1": {
            "description": "A2A 16 MiB victim (35 %) vs A2A 16 MiB aggressor (65 %), alternating nodes",
            "apps": {
                "0": {
                    "path": "blink/alltoall_comm_only.py",
                    "args": "-msgsize 16777216 -iter 1000",
                    "collect": true,
                    "start": "3",
                    "end": "",
                    "partition": "victim"
                },
                "1": {
                    "path": "blink/alltoall_comm_only.py",
                    "args": "-msgsize 16777216 -endl",
                    "collect": false,
                    "start": "0",
                    "end": "f",
                    "partition": "aggressor"
                }
            }
        }
    }
}