            "description": "Single-node Ping-Pong benchmark with 2 processes.",
            "apps": {
                "0": {
                    "path": "ping-pong_b.py",
                    "args": "",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            }
        }
    }
