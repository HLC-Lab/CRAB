{
    "schema_version": 2,
    "global_options": {
        "name": "allreduce_interference",
        "numnodes": "4",
        "ppn": "1",
        "minruns": "5",
        "maxruns": "10",
        "timeout": "1500.0",
        "convergeall": true,
        "outformat": "csv",
        "extrainfo": "allreduce_interference_study",
        "sbatch_directives": {
            "time": "00:30:00",
            "job-name": "crab_ardc_interference"
        },
        "allocation": {
            "mode": "linear",
            "partitions": {
                "victim": {},
                "aggressor": {}
            }
        }
    },
    "experiments": {
        "01_baseline_ardc_small": {
            "description": "AllReduce baseline: small messages (1KB). Latency-bound reference.",
            "apps": {
                "0": {
                    "path": "blink/allreduce_b.py",
                    "args": "-msgsize 1024 -iter 1000",
                    "collect": true,
                    "start": "0",
                    "end": "",
                    "partition": "victim"
                }
            }
        },
        "02_baseline_ardc_large": {
            "description": "AllReduce baseline: large messages (1MB). Bandwidth-bound reference.",
            "apps": {
                "0": {
                    "path": "blink/allreduce_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "start": "0",
                    "end": "",
                    "partition": "victim"
                }
            }
        },
        "03_interference_split": {
            "description": "50/50 split: AllReduce victim (2 nodes) vs Incast aggressor (2 nodes).",
            "apps": {
                "0": {
                    "path": "blink/allreduce_b.py",
                    "args": "-msgsize 1048576 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/incast_b.py",
                    "args": "-endl -msgsize 65536",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "04_topology_ring_nb": {
            "description": "Traffic pattern change: Non-blocking Ring on all nodes.",
            "apps": {
                "0": {
                    "path": "blink/ring_nb.py",
                    "args": "-msgsize 4096 -iter 500",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            },
            "local_options": {
                "allocation": {
                    "mode": "linear"
                }
            }
        },
        "05_stress_a2a_vs_incast": {
            "description": "Stress test: A2A victim vs Incast aggressor on a 50/50 split.",
            "apps": {
                "0": {
                    "path": "blink/alltoall_b.py",
                    "args": "-msgsize 2048 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/incast_b.py",
                    "args": "-endl -msgsize 2048",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        }
    }
}