{
    "global_options": {
        "name": "pingpong_interference",
        "numnodes": "8",
        "ppn": "1",
        "minruns": "5",
        "maxruns": "10",
        "timeout": "3600.0",
        "convergeall": true,
        "outformat": "csv",
        "extrainfo": "pingpong_interference_study",
        "sbatch_directives": {
            "time": "00:30:00",
            "job-name": "crab_pp_interference"
        },
        "system_sbatch": [
            "--exclusive",
            "--account=IscrB_SWING",
            "--partition=boost_usr_prod"
        ],
        "system_header": [
            "module purge"
        ],
        "allocation": {
            "mode": "linear",
            "partitions": {
                "victim": {},
                "aggressor": {}
            }
        }
    },
    "experiments": {
        "01_baseline_pingpong_small": {
            "description": "PingPong baseline: small messages (1KB). All nodes.",
            "apps": {
                "0": {
                    "path": "ping-pong_b.py",
                    "args": "-msgsize 1024 -iter 1000",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            }
        },
        "02_baseline_pingpong_large": {
            "description": "PingPong baseline: large messages (1MB). Bandwidth-bound reference.",
            "apps": {
                "0": {
                    "path": "ping-pong_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            }
        },
        "03_interference_incast": {
            "description": "PingPong victim on half the nodes vs Incast aggressor on the other half. 50/50 split.",
            "apps": {
                "0": {
                    "path": "ping-pong_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 65536 -iter 1000",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "04_topology_ring": {
            "description": "Traffic pattern change: Ring benchmark on all nodes.",
            "apps": {
                "0": {
                    "path": "ring_b.py",
                    "args": "-msgsize 4096 -iter 500",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            }
        },
        "05_stress_a2a_vs_incast": {
            "description": "Stress test: A2A victim vs Incast aggressor on a 50/50 split.",
            "apps": {
                "0": {
                    "path": "a2a_b.py",
                    "args": "-msgsize 2048 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "inc_b.py",
                    "args": "-msgsize 2048 -iter 1000",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        }
    }
}