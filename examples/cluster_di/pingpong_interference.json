{
    "global_options": {
        "name": "pingpong_interference",
        "numnodes": "4",
        "ppn": "1",
        "minruns": "5",
        "maxruns": "10",
        "timeout": "1500.0",
        "convergeall": true,
        "outformat": "csv",
        "extrainfo": "pingpong_interference_study",
        "sbatch_directives": {
            "time": "00:30:00",
            "job-name": "crab_pp_interference",
            "exclusive": true
        },
        "allocation": {
            "mode": "linear",
            "partitions": {
                "victim": {},
                "aggressor": {}
            }
        }
    },
    "experiments": {
        "01_baseline_pingpong_small": {
            "description": "PingPong baseline: small messages (1KB). The 2 victim nodes.",
            "apps": {
                "0": {
                    "path": "blink/pingpong_b.py",
                    "args": "-msgsize 1024 -iter 1000",
                    "collect": true,
                    "start": "0",
                    "end": "",
                    "partition": "victim"
                }
            }
        },
        "02_baseline_pingpong_large": {
            "description": "PingPong baseline: large messages (1MB). Bandwidth-bound reference, 2 victim nodes.",
            "apps": {
                "0": {
                    "path": "blink/pingpong_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "start": "0",
                    "end": "",
                    "partition": "victim"
                }
            }
        },
        "03_interference_incast": {
            "description": "PingPong victim on 2 nodes vs Incast aggressor on the other 2. 50/50 split.",
            "apps": {
                "0": {
                    "path": "blink/pingpong_b.py",
                    "args": "-msgsize 1048576 -iter 100",
                    "collect": true,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/incast_b.py",
                    "args": "-endl -msgsize 65536",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        },
        "04_topology_ring": {
            "description": "Traffic pattern change: Ring benchmark on all 4 nodes.",
            "apps": {
                "0": {
                    "path": "blink/ring_bsnbr.py",
                    "args": "-msgsize 4096 -iter 500",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            },
            "local_options": {
                "allocation": {
                    "mode": "linear"
                }
            }
        },
        "05_stress_a2a_vs_incast": {
            "description": "Stress test: A2A victim vs Incast aggressor on a 50/50 split.",
            "apps": {
                "0": {
                    "path": "blink/alltoall_b.py",
                    "args": "-msgsize 2048 -iter 200",
                    "collect": true,
                    "partition": "victim",
                    "start": "3",
                    "end": ""
                },
                "1": {
                    "path": "blink/incast_b.py",
                    "args": "-endl -msgsize 2048",
                    "collect": false,
                    "partition": "aggressor",
                    "start": "0",
                    "end": "f"
                }
            }
        }
    }
}