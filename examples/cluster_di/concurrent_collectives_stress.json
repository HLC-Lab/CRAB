{
    "schema_version": 2,
    "global_options": {
        "name": "concurrent_collectives_stress",
        "numnodes": "8",
        "ppn": "1",
        "minruns": "5",
        "maxruns": "10",
        "timeout": "1800.0",
        "outformat": "csv",
        "extrainfo": "stress_8_nodes_concurrent_collectives",
        "sbatch_directives": {
            "time": "01:00:00",
            "job-name": "crab_concurrent_stress"
        },
        "allocation": {
            "mode": "linear"
        }
    },
    "experiments": {
        "01_concurrent_collectives": {
            "description": "Four collectives running concurrently on 8 nodes (2 nodes, 2 ranks per app): two A2A, one Barrier, one Ring. Stress test.",
            "apps": {
                "0": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 67108864 -iter 1000 -grty 1",
                    "collect": true,
                    "start": "0",
                    "end": ""
                },
                "1": {
                    "path": "blink/alltoall/alltoall_b.py",
                    "args": "-msgsize 67108864 -iter 500 -grty 1",
                    "collect": true,
                    "start": "0",
                    "end": ""
                },
                "2": {
                    "path": "blink/barrier/barrier_b.py",
                    "args": "-iter 5000",
                    "collect": false,
                    "start": "0",
                    "end": "f"
                },
                "3": {
                    "path": "blink/ring/ring_nb.py",
                    "args": "-msgsize 33554432 -iter 1000",
                    "collect": true,
                    "start": "0",
                    "end": ""
                }
            }
        }
    }
}