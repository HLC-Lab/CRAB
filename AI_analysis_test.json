{
    "global_options": {
        "numnodes": "10",
        "ppn": "4",
        "allocationmode": "p",
        "partitionsplit": "35:65",
        "allocationsplit": "100-100",
        "partitionlayout": "i",
        "minruns": "1",
        "maxruns": "1",
        "timeout": "1200.0",
        "outformat": "csv",
