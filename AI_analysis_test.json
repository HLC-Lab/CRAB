            "exclusive": true
        }
    },
    "experiments": {
        "exp1": {
            "description": "AI Training Analysis with Workerpool and A2A Communication",
            "apps": {
                "0": {
                    "path": "workerpool.py",
                    "args": "--pattern=benchmarks/workerpool/pattern_1.json",
                    "collect": false,
                    "start": "0",
                    "end": "f"
                }
            }
        }
    }
