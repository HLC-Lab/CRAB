{
    "_common": {
        "description": "Common settings shared across all presets. Put your accounts and per-machine changes in local/presets.json (same format, git-ignored), not here.",
        "env": {
            "CRAB_ROOT": "__CWD__",
            "CRAB_PATH_WRAPPERS": "__CWD__/wrappers"
        },
        "sbatch": [],
        "header": []
    },
    "alps": {
        "description": "ALPS Cluster Environment",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": [
                    "--cpu-bind=map_cpu=1,73,145,217"
                ]
            }
        },
        "env": {},
        "sbatch": [],
        "header": []
    },
    "cluster_di": {
        "description": "Cluster Dipartimento Informatica",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": []
            }
        },
        "env": {},
        "sbatch": [],
        "header": []
    },
    "haicgu": {
        "description": "HAICGU Cluster",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": [
                    "--cpu-bind=socket"
                ]
            }
        },
        "env": {
            "CRAB_IB_DEVICES": "mlx5_0#mlx5_1#mlx5_2#mlx5_3"
        },
        "sbatch": [],
        "header": []
    },
    "leonardo": {
        "description": "Leonardo Cluster @ CINECA",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": [
                    "--cpu-bind=socket"
                ]
            }
        },
        "env": {
            "UCX_IB_SL": "1",
            "LD_LIBRARY_PATH": "${LD_LIBRARY_PATH}:/leonardo/smcx_home/bench/software/lib/ucx/nvhpc-22.2_pgi_cuda/lib/",
            "CRAB_IB_DEVICES": "mlx5_0#mlx5_1#mlx5_2#mlx5_3",
            "NCCL_IB_SL": "${UCX_IB_SL}"
        },
        "sbatch": [
            "--account=YOUR_PROJECT_ACCOUNT",
            "--partition=boost_usr_prod",
            "--gres=tmpfs:0"
        ],
        "header": [
            "module purge"
        ]
    },
    "cresco8": {
        "description": "Cresco8 @ ENEA",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": [
                    "--cpu-bind=socket"
                ]
            }
        },
        "env": {
            "LD_LIBRARY_PATH": "${LD_LIBRARY_PATH}:/usr/mpi/intel/openmpi-4.1.7rc1/lib",
            "CRAB_IB_DEVICES": "mlx5_0#mlx5_1#mlx5_2#mlx5_3"
        },
        "sbatch": [
            "--account=YOUR_PROJECT_ACCOUNT",
            "--partition=cresco8_cpu",
            "--auks=yes",
            "--exclusive"
        ],
        "header": []
    },
    "local": {
        "description": "Local (no Slurm, dev/testing only)",
        "scheduler": "local",
        "launcher": "direct",
        "env": {},
        "sbatch": [],
        "header": []
    },
    "lumi": {
        "description": "LUMI Supercomputer",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": []
            }
        },
        "env": {},
        "sbatch": [],
        "header": []
    },
    "nanjing": {
        "description": "Nanjin Cluster",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": [
                    "--cpu-bind=socket"
                ]
            }
        },
        "env": {
            "CRAB_IB_DEVICES": "mlx5_0#mlx5_1#mlx5_2#mlx5_3"
        },
        "sbatch": [],
        "header": []
    },
    "slimfly": {
        "description": "Slimfly Topology Cluster (MPI)",
        "scheduler": "slurm",
        "launcher": "mpirun",
        "launchers": {
            "mpirun": {
                "command": "/scratch/2/t2hx/dep/openmpi/bin/mpirun",
                "flags": [
                    "-mca",
                    "plm_rsh_no_tree_spawn",
                    "1",
                    "--map-by",
                    "node",
                    "-mca",
                    "btl",
                    "openib,self,sm",
                    "-mca",
                    "btl_openib_if_include",
                    "mlx4_0",
                    "-mca",
                    "orte_base_help_aggregate",
                    "0",
                    "--map-by",
                    "node"
                ]
            }
        },
        "env": {},
        "sbatch": [],
        "header": []
    },
    "example_preset": {
        "description": "Example Template",
        "env": {
            "CRAB_ROOT": "__CWD__",
            "ENV_EXAMPLE": "ENV_VALUE"
        },
        "sbatch": [],
        "header": []
    }
}
