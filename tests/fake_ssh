#!/bin/sh
# Fake ssh for the real-MPI tests: drop the ssh options and the host name, log "host: command"
# to fake_ssh.log next to this script, then run the command locally.
while [ $# -gt 0 ]; do case "$1" in -*) shift;; *) break;; esac; done
host="$1"; shift
echo "$host: $*" >> "$(dirname "$0")/fake_ssh.log"
exec /bin/sh -c "$*"
